# Enable automatic OTA rollback:
# if the firmware does not call esp_ota_mark_app_valid_cancel_rollback()
# before the next reboot, the bootloader reverts to the previous firmware.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Increase mbedTLS receive buffer from 16 KB (default) to 32 KB.
# BambuLab's periodic mc_print reports are ~16.8 KB and exceed the default
# TLS record limit, causing INVALID_RECORD errors, heap corruption and
# Guru Meditation crashes.
# NOTE: NOT ACTIVE in this project. These options only take effect when building
# with framework = espidf (or espidf,arduino). We build with framework = arduino,
# whose mbedTLS is pre-compiled at 16 KB, so this file is currently inert and the
# -DMBEDTLS_* build_flags in platformio.ini do not rebuild the library either.
# The 16 KB limit is instead worked around at application level: the firmware never
# requests pushall (see bambulabController::_reconnect) and only parses the small
# periodic reports. Kept here for the day this moves to the espidf framework.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=32768
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
